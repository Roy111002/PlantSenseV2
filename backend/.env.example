# Groq vision-language model
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=qwen/qwen3.8-27b
ENABLE_GROQ=true

DATABASE_PATH=plantsense.sqlite3
UPLOAD_DIR=uploads

# Optional: set a long random secret and send the matching X-Device-Token header from ESP32.
DEVICE_API_TOKEN=

# Legacy Hugging Face settings are no longer used by the active AI pipeline.
ENABLE_HF=false
